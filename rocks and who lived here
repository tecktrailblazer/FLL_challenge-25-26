from hub import port
import motor
import runloop
async def main():

    motor.run_for_degrees(port.E, 1110, 720)
    await motor.run_for_degrees(port.D, -1110, 720)

    await motor.run_for_degrees(port.E, -115, 720)

    await motor.run_for_degrees(port.C, -1000, 720)

    motor.run_for_degrees(port.E, 200, 720)
    await motor.run_for_degrees(port.D, -180, 720)

    motor.run_for_degrees(port.E, -90, 720)
    await motor.run_for_degrees(port.C, 500, 1000)

    
    motor.run_for_degrees(port.E, -200, 720)
    await motor.run_for_degrees(port.D, 200, 720)
    
    await motor.run_for_degrees(port.D, 160, 720)

    motor.run_for_degrees(port.E, 600, 720)
    await motor.run_for_degrees(port.D, -600, 720)

    await motor.run_for_degrees(port.D, 60, 720)

    motor.run_for_degrees(port.E, 600, 720)
    motor.run_for_degrees(port.D, -600, 720)
    
runloop.run(main())
