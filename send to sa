    motor.run_for_degrees(port.E, 160, 720)
    await motor.run_for_degrees(port.D, -140, 720)

    motor.run_for_degrees(port.E, -90, 720)
    await motor.run_for_degrees(port.C, 500, 1000)

    
    motor.run_for_degrees(port.E, -100, 720)
