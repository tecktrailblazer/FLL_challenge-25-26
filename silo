from hub import port, light_matrix
import motor
import runloop

async def main():
    motor.run_for_degrees(port.E, 290, 300)
    await motor.run_for_degrees(port.D, -290, 300)

    for x in range(4):
        await motor.run_for_degrees(port.F, -720, 3000)
        await light_matrix.write('6')
        await motor.run_for_degrees(port.F, 720, 2000)
    motor.run_for_degrees(port.E, -267, 720)
    await motor.run_for_degrees(port.D, 2, 720)


runloop.run(main())
