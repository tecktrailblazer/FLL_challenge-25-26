from hub import port, light_matrix
import motor
import runloop

async def main():
    motor.run_for_degrees(port.E, 340, 300)
    await motor.run_for_degrees(port.D, -340, 300)

    for x in range(3):
        await motor.run_for_degrees(port.F, 300, 820)
        await light_matrix.write('6')
        await motor.run_for_degrees(port.F, -300, 600)
    motor.run_for_degrees(port.E, -300, 720)
    await motor.run_for_degrees(port.D, 300, 720)


runloop.run(main())
